generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Transaction {
  id            Int          @id @default(autoincrement())
  date          DateTime
  symbol        String
  type          String
  quantity      Float
  price         Float
  orderId       String?      @unique
  createdAt     DateTime     @default(now())
  splitRatio    Float?
  newSymbol     String?
  description   String?
  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  
  @@index([date])
  @@index([date, symbol])
  @@index([type])
}

model ImportBatch {
  id           Int           @id @default(autoincrement())
  filename     String
  timestamp    DateTime      @default(now())
  count        Int
  startDate    DateTime?
  endDate      DateTime?
  transactions Transaction[]

  @@index([timestamp])
}

model DailyPortfolioSnapshot {
  id                    Int      @id @default(autoincrement())
  date                  DateTime @unique
  totalEquity           Float
  investedCapital       Float
  portfolioNAV          Float
  niftyNAV              Float?
  units                 Float
  cashflow              Float?
  dailyPnL              Float?
  dailyReturn           Float?
  drawdown              Float?
  navMA200              Float?
  xirr                  Float?
  cagr                  Float?
  nifty500Momentum50NAV Float?
  niftyMicrocap250NAV   Float?
  niftyMidcap100NAV     Float?
  niftySmallcap250NAV   Float?
}

model WeeklyPortfolioSnapshot {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique
  totalEquity      Float
  nav              Float
  weeklyReturn     Float?
  largeCapPercent  Float?
  midCapPercent    Float?
  smallCapPercent  Float?
  microCapPercent  Float?
  marketCap        Float?
  xirr             Float?
  pnl              Float?
  winPercent       Float?
  lossPercent      Float?
  avgHoldingPeriod Float?
  avgWinnerGain    Float?
  avgLoserLoss     Float?
  sectorAllocation String? // JSON: SectorAllocation[]
}

model MonthlyPortfolioSnapshot {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique
  totalEquity      Float
  nav              Float
  monthlyReturn    Float?
  largeCapPercent  Float?
  midCapPercent    Float?
  smallCapPercent  Float?
  microCapPercent  Float?
  marketCap        Float?
  xirr             Float?
  pnl              Float?
  winPercent       Float?
  lossPercent      Float?
  avgHoldingPeriod Float?
  avgWinnerGain    Float?
  avgLoserLoss     Float?
  exitCount        Int?     @default(0)
  avgExitsPerMonth Float?   @default(0)
  sectorAllocation String? // JSON: SectorAllocation[]
}

model StockHistory {
  id     Int      @id @default(autoincrement())
  date   DateTime
  symbol String
  close  Float

  @@unique([date, symbol])
  @@index([symbol])
  @@index([date])
}

model IndexHistory {
  date   DateTime
  symbol String
  close  Float

  @@id([date, symbol])
  @@index([date])
  @@index([symbol])
}





model SymbolMapping {
  id        Int      @id @default(autoincrement())
  oldSymbol String   @unique
  newSymbol String
  createdAt DateTime @default(now())
}

model Job {
  id        String   @id @default(cuid())
  type      String
  status    String
  progress  Int      @default(0)
  message   String?
  result    String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SectorMapping {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  sector    String
  exchange  String   @default("NSE")
  updatedAt DateTime @updatedAt

  @@index([sector])
}

// Upstox API token storage for semi-automated authentication
model UpstoxToken {
  id          Int      @id @default(autoincrement())
  accessToken String
  expiresAt   DateTime
  issuedAt    DateTime
  userId      String?  // Upstox user ID (UCC)
  createdAt   DateTime @default(now())
  
  @@index([expiresAt])
}

// AMFI Market Cap Classification
// Stores stock classifications from AMFI (Large/Mid/Small Cap)
// Updated every 6 months based on AMFI data releases
model AMFIClassification {
  id           Int      @id @default(autoincrement())
  period       String   // Format: "2024_H1" or "2024_H2"
  rank         Int      // Company rank by market cap
  companyName  String
  symbol       String   // NSE trading symbol
  isin         String   // ISIN code for cross-reference
  category     String   // "Large", "Mid", or "Small"
  avgMarketCap Float    // Average market cap in Crores
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([period, symbol])
  @@index([symbol])
  @@index([period])
  @@index([category])
}

// AMFI Import History
// Tracks when AMFI classification data was imported
model AMFIImportHistory {
  id           Int      @id @default(autoincrement())
  period       String   // Format: "2024_H1" or "2024_H2"
  sourceFile   String   // Original PDF filename
  stockCount   Int      // Number of stocks imported
  largeCapCount Int     // Count of Large Cap stocks
  midCapCount   Int     // Count of Mid Cap stocks
  smallCapCount Int     // Count of Small Cap stocks
  microCapCount Int     // Count of Micro Cap stocks (rank > 500)
  importedAt   DateTime @default(now())
  
  @@index([period])
}

// Intraday P/L History
// Stores P/L snapshots every 1 minute during market hours
// Only keeps current day's data, previous days are auto-cleaned
model IntradayPnL {
  id              Int      @id @default(autoincrement())
  timestamp       DateTime @default(now())
  date            DateTime // Date only (for easy filtering/cleanup)
  pnl             Float    // Absolute P/L value
  percent         Float    // P/L percentage
  nifty50Percent  Float?   // Nifty 50 % change at this snapshot (nullable for backcompat)
  n500m50Percent  Float?   // Nifty500 Momentum 50 % change at this snapshot (nullable for backcompat)

  @@index([date])
}

// ===== Momentum Screener Models =====

// Daily OHLCV candles for all NSE stocks (for Sharpe/DMA/volume computation)
model ScreenerPrice {
  id            Int    @id @default(autoincrement())
  symbol        String
  instrumentKey String
  date          String // YYYY-MM-DD
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float  // Raw share volume. Turnover = close × volume.

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}

// Running all-time high per stock (seeded from monthly candles since 2000)
model StockATH {
  symbol        String   @id
  instrumentKey String
  ath           Float
  athDate       String   // YYYY-MM-DD when ATH was reached
  updatedAt     DateTime @default(now())
}

// Demerger adjustments applied to ScreenerPrice (idempotency tracking)
model ScreenerDemerger {
  id        Int      @id @default(autoincrement())
  symbol    String
  exDate    String   // YYYY-MM-DD
  ratio     Float    // open(exDate) / close(dayBefore) — typically 0.3-0.95
  appliedAt DateTime @default(now())

  @@unique([symbol, exDate])
}

// Daily computed momentum scores (full scored universe)
model MomentumScore {
  id                Int      @id @default(autoincrement())
  computedDate      String   // YYYY-MM-DD
  symbol            String
  instrumentKey     String
  companyName       String
  rank              Int
  compositeScore    Float
  avgSharpe         Float
  sharpe12m         Float
  sharpe6m          Float
  sharpe3m          Float
  athProximity      Float    // currentClose / ATH (0 to 1.0)
  ath               Float    // ATH price
  currentPrice      Float
  dma200            Float    // 200-day simple moving average
  aboveDma200Pct    Float    // % above/below 200 DMA
  aboveDma10        Boolean  @default(false)
  aboveDma20        Boolean  @default(false)
  aboveDma50        Boolean  @default(false)
  aboveDma100       Boolean  @default(false)
  medianTurnoverCr  Float    // Median daily turnover in Crores
  marketCapCr       Float    // Market cap in Crores (from NSE bhavcopy)
  marketCapCategory String?  // Large/Mid/Small/Micro (from AMFI)
  sparklineData     String?  // JSON: last 50 closes, oldest-first
  circuitBandPct    Float?   // Circuit band width %
  // Denormalized from RankingHistory (avoids JOINs on page load)
  prevRank          Int?     // Previous day's rank (for change indicator)
  avgRank50d        Float?   // Average rank over last 50 trading days
  bestRank          Int?     // Best (lowest) rank in last 50 days
  appearances       Int      @default(0)  // Days ranked in last 50 trading days
  t50Pct            Float    @default(0)  // % of last 50 days in top 50
  t100Pct           Float    @default(0)  // % of last 50 days in top 100
  rankType          String   @default("filtered")
  isActive          Boolean  @default(true)

  @@unique([computedDate, symbol, rankType])
  @@index([computedDate, isActive, rankType])
  @@index([isActive, rank, rankType])
  @@index([symbol])
}

// Daily rank snapshots (retained for 50 trading days)
model RankingHistory {
  id             Int    @id @default(autoincrement())
  symbol         String
  date           String // YYYY-MM-DD
  rank           Int
  compositeScore Float
  rankType       String @default("filtered")

  @@unique([symbol, date, rankType])
  @@index([symbol])
  @@index([date])
}

// Market cap from NSE bhavcopy (updated daily by cron)
model StockMarketCap {
  symbol    String   @id
  marketCap Float    // in Crores
  updatedAt DateTime @default(now())
}

// Dividend records from Zerodha Tax P&L upload
// Dedup key: (isin, exDate) — upsert on re-upload of same period
model Dividend {
  id              Int       @id @default(autoincrement())
  isin            String
  symbol          String?   // NSE symbol (resolved from ISIN if available)
  exDate          DateTime  // Ex-dividend date
  payDate         DateTime? // Payment date (optional, may not be in sheet)
  amount          Float     // Total dividend received (₹)
  dps             Float?    // Dividend per share (₹)
  quantity        Float?    // Shares held at ex-date
  fiscalYear      String    // e.g. "2026_2027" — extracted from filename
  quarter         String?   // e.g. "Q1-Q2" — extracted from filename
  source          String    @default("zerodha_taxpnl")
  transferredBack Boolean   @default(false) // manually transferred back to broker account
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([isin, exDate])
  @@index([isin])
  @@index([symbol])
  @@index([fiscalYear])
  @@index([exDate])
}

// User's custom Radar watchlist symbols (holdings are merged in separately).
model RadarWatchlist {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Configurable news source domains for the Radar news panel (seeded with
// defaults on first use; user can add/remove any public domain).
model RadarNewsSource {
  id        Int      @id @default(autoincrement())
  domain    String   @unique
  isPrivate Boolean  @default(false)
  // Provider adapter for this source: "rss" (default website feed) or "x"
  // (X/Twitter API). Determines which credential fields apply.
  provider  String   @default("rss")
  // Provider-specific credentials as a JSON key→value map (e.g. bearerToken).
  // Stored in the user's own DB and never returned to the client (only a
  // `hasAuth` flag is exposed).
  authConfig String?
  // Legacy single-credential columns (kept for backward compatibility).
  authToken String?
  authUser  String?
  authPass  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
